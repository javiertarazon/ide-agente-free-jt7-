{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🎬 Pipeline Completo: Prompt → Video",
      "type": "shell",
      "command": "cd ${workspaceFolder} && python agents/video_pipeline_agent.py --prompt \"${input:videoPrompt}\" --verbose",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "🎨 Solo Claude Design",
      "type": "shell",
      "command": "cd ${workspaceFolder} && python agents/claude_design_agent.py --prompt \"${input:designPrompt}\" --verbose",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "⚛️ Solo Remotion (desde design.json)",
      "type": "shell",
      "command": "cd ${workspaceFolder} && python agents/remotion_agent.py --design design_output.json --output output_videos/video.mp4",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "▶️ Remotion Studio (preview)",
      "type": "shell",
      "command": "cd ${workspaceFolder}/remotion_project && npx remotion studio",
      "group": "build",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "owner": "remotion",
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting Remotion",
          "endsPattern": "Server started"
        }
      }
    },
    {
      "label": "🔄 Pipeline Interactivo",
      "type": "shell",
      "command": "cd ${workspaceFolder} && python agents/video_pipeline_agent.py --interactive",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "🎨 Generar Diseño en Canva",
      "type": "shell",
      "command": "cd ${workspaceFolder} && python agents/canva_agent.py --action generate --type \"${input:canvaType}\" --prompt \"${input:canvaPrompt}\" --verbose",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "new" }
    },
    {
      "label": "🔍 Buscar Diseños en Canva",
      "type": "shell",
      "command": "cd ${workspaceFolder} && python agents/canva_agent.py --action search --prompt \"${input:searchQuery}\" --verbose",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "new" }
    },
    {
      "label": "📤 Exportar Diseño Canva como MP4",
      "type": "shell",
      "command": "cd ${workspaceFolder} && python agents/canva_agent.py --action export --design-id \"${input:canvaDesignId}\" --format mp4 --verbose",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "new" }
    },
    {
      "label": "✏️ Editar Diseño en Canva",
      "type": "shell",
      "command": "cd ${workspaceFolder} && python agents/canva_agent.py --action edit --design-id \"${input:canvaDesignId}\" --prompt \"${input:editInstructions}\" --verbose",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "new" }
    },
    {
      "label": "🎯 Brand Kits de Canva",
      "type": "shell",
      "command": "cd ${workspaceFolder} && python agents/canva_agent.py --action brandkits --verbose",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "new" }
    },
    {
      "label": "🔄 Canva Interactivo (sesión libre)",
      "type": "shell",
      "command": "cd ${workspaceFolder} && python agents/canva_agent.py --interactive",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "new" }
    },
    {
      "label": "🌟 Pipeline Maestro: Canva + Remotion",
      "type": "shell",
      "command": "cd ${workspaceFolder} && python agents/master_pipeline.py --mode full --prompt \"${input:masterPrompt}\" --type \"${input:canvaType}\" --verbose",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "new" }
    },
    {
      "label": "🎬 Pipeline: Solo Canva → MP4",
      "type": "shell",
      "command": "cd ${workspaceFolder} && python agents/master_pipeline.py --mode canva --prompt \"${input:masterPrompt}\" --format mp4 --verbose",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "new" }
    },
    {
      "label": "⚛️ Pipeline: Solo Remotion → MP4",
      "type": "shell",
      "command": "cd ${workspaceFolder} && python agents/master_pipeline.py --mode remotion --prompt \"${input:masterPrompt}\" --verbose",
      "group": "build",
      "presentation": { "reveal": "always", "panel": "new" }
    },
    {
      "label": "📦 Instalar dependencias Python",
      "type": "shell",
      "command": "pip install anthropic python-dotenv rich typer",
      "group": "build"
    },
    {
      "label": "📦 Instalar dependencias Remotion",
      "type": "shell",
      "command": "cd ${workspaceFolder}/remotion_project && npm install",
      "group": "build"
    }
  ],
  "inputs": [
    {
      "id": "masterPrompt",
      "type": "promptString",
      "description": "🌟 Describe tu campaña/video completo:",
      "default": "Campaign de lanzamiento para app de productividad, estilo moderno y profesional"
    },
    {
      "id": "canvaPrompt",
      "type": "promptString",
      "description": "🎨 Describe el diseño de Canva:",
      "default": "Poster moderno para lanzamiento de producto tech"
    },
    {
      "id": "canvaType",
      "type": "pickString",
      "description": "🖼️ Tipo de diseño en Canva:",
      "options": ["poster", "presentation", "instagram_post", "youtube_thumbnail", "flyer", "infographic", "facebook_post", "report", "doc"],
      "default": "poster"
    },
    {
      "id": "canvaDesignId",
      "type": "promptString",
      "description": "🆔 ID del diseño de Canva (empieza con D, 11 caracteres):",
      "default": "DABCxyz1234"
    },
    {
      "id": "editInstructions",
      "type": "promptString",
      "description": "✏️ ¿Qué cambios quieres hacer al diseño?",
      "default": "Cambia el título principal a 'Nuevo Producto 2026' y el fondo a azul oscuro"
    },
    {
      "id": "searchQuery",
      "type": "promptString",
      "description": "🔍 Término de búsqueda en Canva:",
      "default": "campaña marketing 2026"
    },
    {
      "id": "videoPrompt",
      "type": "promptString",
      "description": "🎬 Describe el video que quieres crear:",
      "default": "Video promocional de 15 segundos para una app de productividad, estilo minimalista y moderno"
    },
    {
      "id": "designPrompt",
      "type": "promptString",
      "description": "🎨 Describe el sistema de diseño:",
      "default": "Diseño minimalista tech con paleta azul/blanco, tipografía bold"
    }
  ]
}
